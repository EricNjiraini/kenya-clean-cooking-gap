# ── Data ────────────────────────────────────────────────────────
# All raw, processed, and shapefile data is excluded from Git.
# Data is either too large, not redistributable (DHS licence),
# or regenerated by running the notebooks.
# See notebooks/01_data_collection.ipynb for download instructions.

data/raw/
data/processed/
data/shapefiles/

# Keep the folder structure in Git
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/shapefiles/.gitkeep

# ── Outputs ─────────────────────────────────────────────────────
# Generated outputs are excluded — they are produced by running
# the notebooks and are too large for routine commits.
outputs/maps/
outputs/charts/
outputs/tables/

# Keep folder structure
!outputs/maps/.gitkeep
!outputs/charts/.gitkeep
!outputs/charts/eda/.gitkeep
!outputs/tables/.gitkeep

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
# Notebook outputs (strip before committing for clean diffs)
# Use: jupyter nbconvert --clear-output --inplace notebooks/*.ipynb

# ── Environments ────────────────────────────────────────────────
.env
.venv
venv/
env/
*.env

# ── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.zip
